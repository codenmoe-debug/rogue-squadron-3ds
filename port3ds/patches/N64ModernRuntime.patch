diff --git a/librecomp/src/ai.cpp b/librecomp/src/ai.cpp
index 681c77a..cb60db3 100644
--- a/librecomp/src/ai.cpp
+++ b/librecomp/src/ai.cpp
@@ -7,8 +7,31 @@
 
 #define VI_NTSC_CLOCK 48681812
 
+#ifdef __3DS__
+// The 3DS caps the output rate: the MusyX synth's work grows with the rate, and the game reads the rate
+// osAiSetFrequency returns (stored at 0x801496F4, used for tempo and envelopes), so it synthesizes at the
+// capped rate. Default 22050 (the game's own rate outside cutscenes, which ask for 32000); an
+// audio_rate.txt in the app folder holding a number (8000..48000) sets another cap.
+static uint32_t audio_rate_cap() {
+    static uint32_t cap = 0;
+    if (cap == 0) {
+        cap = 22050;
+        if (FILE* f = std::fopen("audio_rate.txt", "r")) {
+            unsigned v = 0;
+            if (std::fscanf(f, "%u", &v) == 1 && v >= 8000 && v <= 48000) cap = v;
+            std::fclose(f);
+        }
+        fprintf(stderr, "[audio] output rate cap %u Hz\n", (unsigned)cap);
+    }
+    return cap;
+}
+#endif
+
 extern "C" void osAiSetFrequency_recomp(uint8_t* rdram, recomp_context* ctx) {
     uint32_t freq = ctx->r4;
+#ifdef __3DS__
+    if (freq > audio_rate_cap()) freq = audio_rate_cap();
+#endif
     // This makes actual audio frequency more accurate to console, but may not be desirable
     //uint32_t dacRate = (uint32_t)(((float)VI_NTSC_CLOCK / freq) + 0.5f);
     //freq = VI_NTSC_CLOCK / dacRate;
